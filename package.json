    "copy-vendor": "node -e \"const f=require('fs');f.copyFileSync('node_modules/@supabase/supabase-js/dist/umd/supabase.js','public/vendor/supabase.js');f.copyFileSync('node_modules/jsbarcode/dist/JsBarcode.all.min.js','public/vendor/jsbarcode.js');console.log('vendor actualizado')\"",
